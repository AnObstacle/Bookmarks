{
  "name": "bookmarks-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run build:bookmarks",
    "start": "ng serve",
    "prestart:arhs": "npm run build:bookmarks",
    "start:arhs": "ng serve --configuration=arhs",
    "build:bookmarks": "ng build bookmarks",
    "prebuild:demo": "npm run build:bookmarks",
    "build:demo": "ng build demo",
    "prebuild:arhs": "npm run build:bookmarks",
    "build:arhs": "ng build demo --configuration=arhs",
    "watch": "ng build bookmarks --watch --configuration development",
    "pretest": "npm run build:bookmarks",
    "test": "ng test --no-watch --no-progress --browsers=ChromeHeadless",
    "deploy": "firebase deploy",
    "firebase": "firebase",
    "canICommit": "npm run build:demo && npm run test && npm run ng -- make-this-awesome"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-browser-dynamic": "^22.1.4",
    "@angular/router": "^22.1.4",
    "bootstrap": "^5.3.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@types/jasmine": "~5.1.0",
    "firebase-tools": "^15.28.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.1.1",
    "typescript": "~6.0.3"
  }
}
